# =====================================================================
# macOS / Xcode .gitignore for MacStatus
# 参考 GitHub 官方 Swift.gitignore + Objective-C.gitignore，针对 menu bar
# agent app 项目调整
# =====================================================================

# ----- macOS 系统垃圾 -----
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ----- Xcode user-specific -----
xcuserdata/
*.xcuserstate
*.xcuserdatad/
project.xcworkspace/xcuserdata/
*.xcscmblueprint
*.xccheckout

# ----- Xcode build / derived data -----
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive
*.xcresult

# ----- Xcode shared schemes（保留 = 注释掉；如果你不想分享，取消注释） -----
# xcshareddata/

# ----- Swift Package Manager -----
.swiftpm/
.build/
Packages/
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# ----- CocoaPods（预防未来引入） -----
Pods/
*.podspec.lock

# ----- Carthage（预防未来引入） -----
Carthage/Build/
Carthage/Checkouts

# ----- fastlane（预防未来引入） -----
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ----- Provisioning / 签名（不应入库） -----
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# ----- IDE / 编辑器 -----
.idea/
.vscode/
*.swp
*.swo
*~

# ----- Claude / AI session 元数据 -----
.claude/

# ----- Release 产物（发布到 GitHub Releases，不入库） -----
*.zip
*.dmg
*.pkg
NetSpeed-*.zip
MacStatus-*.zip

# ----- 日志 / 临时 -----
*.log
*.tmp
*.bak
*.orig
